# FRMS 환경 설정 예시. 이 파일을 .env 로 복사해 값을 채운다.
# .env 가 없으면 아래 기본값(SQLite + 개발용 로컬 로그인)으로 동작한다.

# --- 데이터베이스 ---
# SQLite (기본, 설치 불필요)
DATABASE_URL=sqlite:///./frms.db
# PostgreSQL 로 전환할 때 (psycopg 설치 필요)
# DATABASE_URL=postgresql+psycopg://frms:password@localhost:5432/frms

# --- 세션 ---
# 운영 환경에서는 반드시 임의의 긴 문자열로 바꾼다.
SESSION_SECRET=dev-only-secret-change-me

# --- Microsoft Entra ID SSO (FR-401) ---
# 아래 세 값이 모두 있으면 SSO 모드로 동작하고, 개발용 로컬 로그인은 닫힌다.
# 오픈 이슈 O3(앱 등록 승인)이 해결된 뒤 채운다.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
